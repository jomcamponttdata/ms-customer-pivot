{
  "info": {
    "_postman_id": "91c06c4b-e9d0-4167-aa2e-2b034cc1aaf5",
    "name": "ms-customer - Part II",
    "description": "Part II verification: optional VIP/PYME customer profiles. Requires ms-customer only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Create VIP personal customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('VIP customer created', () => pm.response.to.have.status(201));",
              "const b=pm.response.json(); pm.test('Profile is VIP', () => pm.expect(b.customerProfile).to.equal('VIP'));",
              "pm.environment.set('vipCustomerId', b.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "customers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerType\": \"PERSONAL\",\n  \"customerProfile\": \"VIP\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"86078056\",\n  \"name\": \"Part II VIP Test\",\n  \"email\": \"vip86078056@example.com\",\n  \"phone\": \"987654321\",\n  \"address\": \"Av. Test 1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
