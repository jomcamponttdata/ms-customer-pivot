{
  "info": {
    "name": "ms-customer - Part I",
    "_postman_id": "3e9cbaf3-9f31-4ee3-ae7d-c2cb3f7c2f8e",
    "description": "CRUD collection for customer-service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "correlationId",
      "value": "customer-postman-001"
    }
  ],
  "item": [
    {
      "name": "Create customer - Personal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
              "var body = pm.response.json();",
              "pm.collectionVariables.set(\"customerId\", body.id);",
              "pm.test(\"Created customer is personal and active\", function () {",
              "  pm.expect(body.customerType).to.eql(\"PERSONAL\");",
              "  pm.expect(body.status).to.eql(\"ACTIVE\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerType\": \"PERSONAL\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"12345678\",\n  \"name\": \"Ana Perez\",\n  \"email\": \"ana@example.com\",\n  \"phone\": \"987654321\",\n  \"address\": \"Lima\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/customers"
      },
      "response": []
    },
    {
      "name": "Create customer - Business",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerType\": \"BUSINESS\",\n  \"documentType\": \"RUC\",\n  \"documentNumber\": \"20123456789\",\n  \"name\": \"Servicios Generales SAC\",\n  \"email\": \"contacto@example.com\",\n  \"phone\": \"999999999\",\n  \"address\": \"Arequipa\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/customers"
      },
      "response": []
    },
    {
      "name": "Create duplicate document - Conflict",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerType\": \"PERSONAL\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"12345678\",\n  \"name\": \"Ana Perez\",\n  \"email\": \"ana@example.com\",\n  \"phone\": \"987654321\",\n  \"address\": \"Lima\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/customers"
      },
      "response": []
    },
    {
      "name": "List customers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers?customerType=PERSONAL&page=0&size=20"
      },
      "response": []
    },
    {
      "name": "Find customer by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
      },
      "response": []
    },
    {
      "name": "Update customer",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"12345678\",\n  \"name\": \"Ana Gomez\",\n  \"email\": \"ana.gomez@example.com\",\n  \"phone\": \"999888777\",\n  \"address\": \"Cusco\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
      },
      "response": []
    },
    {
      "name": "Delete customer - Logical",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
      },
      "response": []
    },
    {
      "name": "Find deleted customer",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
      },
      "response": []
    },
    {
      "name": "Activate customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test(\"Customer is active\", function () { pm.expect(body.status).to.eql(\"ACTIVE\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers/{{customerId}}/activate"
      },
      "response": []
    },
    {
      "name": "List inactive customers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers?status=INACTIVE&page=0&size=20"
      },
      "response": []
    },
    {
      "name": "List all customers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers?status=ALL&page=0&size=20"
      },
      "response": []
    }
  ]
}
